# Hedera Operator Account (pays transaction fees)
OPERATOR_ACCOUNT_ID=0.0.XXXXX
OPERATOR_PRIVATE_KEY=302e...

# Treasury Account (holds minted NFTs before distribution)
TREASURY_ACCOUNT_ID=0.0.XXXXX
TREASURY_PRIVATE_KEY=302e...

# NFT Token Collection ID (set after collection creation)
TOKEN_ID=0.0.XXXXX

# Hedera Network: testnet or mainnet
HEDERA_NETWORK=testnet

# HTTP server port
PORT=3000
